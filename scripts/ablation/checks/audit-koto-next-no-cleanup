#!/usr/bin/env python3
"""Audit check: every `koto next` a /work-on run makes carries --no-cleanup.

The rule is skills/work-on/SKILL.md#L359-L362 at
2a3719ed64d3c5b8c4bf65f4e19f2a530b25ad10. Nothing checks it in a normal run.

Contract (docs/measurement/offload-ablation/README.md): called with a run
directory; reads koto-calls.jsonl, the wrapper's log of the agent's koto calls.
Exits 0 (complied), 1 (violated) or 2 (not-checkable) and prints a reason code
first.

Reason codes: ok, missing-no-cleanup, no-koto-next, unreadable.
"""

import json
import os
import sys


def main():
    try:
        with open(os.path.join(sys.argv[1], "koto-calls.jsonl")) as fh:
            calls = [json.loads(line) for line in fh if line.strip()]
    except (IndexError, OSError, ValueError):
        print("unreadable")
        return 2
    nexts = [c.get("argv", []) for c in calls if c.get("argv", [])[:1] == ["next"]]
    if not nexts:
        print("no-koto-next")
        return 2
    if any("--no-cleanup" not in argv for argv in nexts):
        print("missing-no-cleanup")
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
