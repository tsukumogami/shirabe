#!/usr/bin/env python3
"""Deployed check for /work-on's introspection-evidence section.

The section (skills/work-on/references/phases/phase-2-introspection.md#L17-L21
at 3cc4c54b8afa95b62c544a0d4b99990ba08d8609) is the prose statement of what
each outcome the introspection state accepts means:

    - `approach_unchanged` - original approach still valid
    - `approach_updated` - adjustments needed
    - `issue_superseded` - issue no longer relevant

It is not the only statement: the work-on template also lists the three values
and describes `rationale` as "What changed or why the issue is superseded". koto
already refuses an outcome outside the three values, so this check leaves that
to koto and grades what a run does with the meanings: an `approach_updated`
verdict says what the adjustments are, and an `issue_superseded` verdict says
why, in `rationale`. The template builds the workflow's failure reason from
that field when the issue is superseded, so an empty one leaves a blank reason.
The section states the meanings but never names the field, so the two arms can
differ here only as far as the meanings lead a run to explain its verdict; a
small effect, and a case that reads as "no difference" says little.

Contract (docs/measurement/offload-ablation/README.md): called with the path of
a production file holding {"workflow", "state", "evidence"}. Exits 0
(complied), 1 (violated) or 2 (not-checkable); prints a reason code first and,
on violated, the failure message to deliver. The evidence is read as data.

Reason codes: ok, rationale-missing, enum-left-to-koto, unreadable.
"""

import json
import sys

OUTCOMES = ("approach_unchanged", "approach_updated", "issue_superseded")

SECTION = '## Evidence\n\n- `approach_unchanged` — original approach still valid\n- `approach_updated` — adjustments needed\n- `issue_superseded` — issue no longer relevant'


def main():
    try:
        with open(sys.argv[1]) as fh:
            evidence = json.load(fh).get("evidence")
    except (IndexError, OSError, ValueError, AttributeError):
        print("unreadable")
        return 2
    if not isinstance(evidence, dict):
        print("unreadable")
        return 2
    outcome = evidence.get("introspection_outcome")
    if outcome not in OUTCOMES:
        print("enum-left-to-koto")
        return 2
    rationale = evidence.get("rationale")
    if outcome in ("approach_updated", "issue_superseded") \
            and not (isinstance(rationale, str) and rationale.strip()):
        print("rationale-missing")
        print(f"introspection_outcome {outcome} needs its reason in `rationale`: for "
              "approach_updated the adjustments, for issue_superseded why the issue no "
              "longer applies. The meanings for this state:")
        print(SECTION)
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
