#!/bin/sh
# Failing stub claude for scripts/run-evals_test.sh. Never calls a model.
#
# The harness runs script-graded cases only and has no path to claude, so a
# run must never start this. When it is started anyway, it appends one line
# to the file $STUB_CLAUDE_RECORD names (its arguments, space-separated, after
# the word `call`), so the suite can show the record stayed empty, and exits
# non-zero, so nothing that reached it could read as a passing run.

if [ -n "${STUB_CLAUDE_RECORD:-}" ]; then
  printf 'call %s\n' "$*" >> "$STUB_CLAUDE_RECORD"
fi
echo "stub claude: the eval harness must not start claude" >&2
exit 97
