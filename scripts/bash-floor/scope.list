workflow: .github/workflows/check-scope-scripts.yml
# Citations, intake, the /plan hop's consistency check, resume
# routing, publish, and the exit records. A gh stub and a local bare
# origin stand in for GitHub; the koto and shirabe cases skip here
# and run on the Linux jobs that install both.
skills/scope/scripts/check-citations_test.sh
skills/scope/scripts/resolve-intent_test.sh
skills/scope/scripts/check-recorded-intent_test.sh
skills/scope/scripts/check-upstream_test.sh
skills/scope/scripts/check-plan-mode_test.sh
skills/scope/scripts/run-intake_test.sh
skills/scope/scripts/scope-template_test.sh
skills/scope/scripts/resume-probe_test.sh
skills/scope/scripts/startable-issues_test.sh
skills/scope/scripts/record-executed-report_test.sh
skills/scope/scripts/record-scope-exit_test.sh
skills/scope/scripts/publish-scoping-pr_test.sh
skills/scope/scripts/print-scope-exit_test.sh
skills/scope/scripts/check-hop-document_test.sh
skills/scope/scripts/scope-check-exit_test.sh
# The document check and event scripts share the hop gate's validator
# library; their stub validator and stub koto run every case on the floor.
scripts/doc-check_test.sh
scripts/doc-events_test.sh
scripts/review-events_test.sh
scripts/doc-check-wiring_test.sh
scripts/doc-shadow-check_test.sh
