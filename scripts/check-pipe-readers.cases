# check-pipe-readers_test.sh's fixtures: <kind>\t<label>\t<shell line>.
# kind is refused (the check must name the line) or fine (it must pass it).
# <NL> in a shell line is a newline: the line is continued, and a refused one
# is named by its first line. Kept out of the test script itself because the
# check scans every tracked *.sh, this suite's own file included.
refused	printf into grep -q	printf '%s' "$OUT" | grep -q done
refused	echo into a quiet flag cluster	echo "$OUT" | grep -Fqx -- "$want"
refused	printf into grep --quiet	printf '%s\n' "$OUT" | grep --quiet x
refused	printf into grep -m 1	printf '%s\n' "$OUT" | grep -m 1 x
refused	printf into head	first=$(printf '%s\n' "$OUT" | head -1)
refused	cat of a file into grep -q	cat "$f" | grep -q x
refused	after if	if printf '%s' "$OUT" | grep -q x; then :; fi
refused	after elif	elif printf '%s' "$OUT" | grep -qv x; then :
refused	after !	! printf '%s' "$OUT" | grep -q x
refused	after &&	[ "$rc" = 0 ] && printf '%s' "$OUT" | grep -q x
refused	a reader behind a variable assignment	if printf '%s' "$x" | LC_ALL=C grep -q '[[:cntrl:]]'; then :; fi
refused	inside a command substitution	msg="got $(echo "$OUT" | head -c 300)"
refused	a continued line, named by its first line	if [ "$rc" = 0 ] \<NL>    && printf '%s' "$OUT" \<NL>    | grep -q x; then :; fi
fine	a here-string	grep -q done <<<"$OUT"
fine	grep -c reads everything	n=$(printf '%s\n' "$OUT" | grep -c .)
fine	grep with no quiet flag, then a test	if [ "$(printf '%s' "$k" | grep -c x)" -eq 1 ]; then :; fi
fine	grep to /dev/null reads everything	printf '%s' "$OUT" | grep x >/dev/null
fine	another writer	jq -r .x "$f" | grep -q y
fine	a comment	# printf '%s' "$OUT" | grep -q x
fine	the pipe of a command substitution in the writer's arguments	echo "against $(koto version | head -1)"
refused	head after a middle stage (#906)	t=$(printf '%s\n' "$v" | sed -n 's/^topic //p' | head -1)
refused	grep -q after a middle stage, any writer	ctx report.md | grep -A2 '^## x' | grep -q y
refused	head in the middle, then cut	b=$(tail -n "+$a" "$f" | grep -n -F -- "$x" | head -n 1 | cut -d: -f1)
refused	a lone read after a middle stage	jq -r .x "$f" | tr -d x | read -r y
refused	inside a command substitution in double quotes	fail "got $(ct_calls | grep -E '^pr' | head -1)"
refused	after an or-list	[ -n "$x" ] || jq -r .a "$f" | sed 1d | grep -q b
refused	grep -m after a middle stage	v=$(jq -r .x "$f" | tr -d y | grep -m 1 z)
fine	a pipe inside a single-quoted pattern	v=$(grep -E 'a|b|head' "$f" | sort)
fine	a pipe inside a double-quoted message	bad "x | y | head" "$(jq -r .x "$f")"
fine	a case pattern list	jq|grep|egrep|head|read) n=1 ;;
fine	the middle stage captured, then a here-string	m=$(ctx r.md | grep -A2 x); grep -q y <<<"$m"
fine	sed quits by itself	t=$(sed -n '/^topic /{s///p;q;}' <<<"$v")
fine	while read reads to the end	jq -r .x "$f" | tr -d y | while read -r l; do :; done
fine	two stages from a program	jq -r .x "$f" | head -1
fine	grep -c after a middle stage	n=$(jq -r .x "$f" | tr -d y | grep -c z)
fine	the reader's status read from PIPESTATUS	jq -r .x "$f" | tr -d y | grep -q z<NL>rc=${PIPESTATUS[2]}
