#!/usr/bin/env bash
set -euo pipefail

# koto shim for eval scenarios
# Reads EVAL_SCENARIO env var and returns canned data from fixtures/scenarios/<scenario>/

FIXTURES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCENARIO_DIR="$FIXTURES_DIR/scenarios/${EVAL_SCENARIO:-}"

if [ -z "${EVAL_SCENARIO:-}" ]; then
  echo "Error: EVAL_SCENARIO not set" >&2
  exit 1
fi

# Scenario: koto not installed — simulate command not found
if [ "$EVAL_SCENARIO" = "koto-missing" ]; then
  echo "bash: koto: command not found" >&2
  exit 127
fi

# Normalize args for pattern matching
ARGS="$*"

# Where the stateful `context` verbs keep their markers. Scenario-scoped so two
# scenarios in one run cannot see each other's keys. The runner may pin it; the
# fallback is a per-scenario temp directory.
CTX_STATE="${KOTO_SHIM_CTX_STATE:-${TMPDIR:-/tmp}/koto-shim-ctx/$EVAL_SCENARIO}"

case "$ARGS" in
  "version"|*"--version"*)
    echo '{"version":"0.2.1"}'
    exit 0
    ;;
  "workflows"|"workflows "*)
    if [ -f "$SCENARIO_DIR/koto-workflows.json" ]; then
      cat "$SCENARIO_DIR/koto-workflows.json"
      exit 0
    fi
    # Default: no active workflows
    echo '[]'
    exit 0
    ;;
  *"next work-on"*|*"next"*"work-on"*)
    if [ -f "$SCENARIO_DIR/koto-next-work-on.json" ]; then
      cat "$SCENARIO_DIR/koto-next-work-on.json"
      exit 0
    fi
    ;;
  "init"*|*"init "*)
    if [ -f "$SCENARIO_DIR/koto-init.json" ]; then
      cat "$SCENARIO_DIR/koto-init.json"
      exit 0
    fi
    # Default: successful init
    echo '{"status":"initialized","workflow":"work-on"}'
    exit 0
    ;;
  *"transition"*)
    if [ -f "$SCENARIO_DIR/koto-transition.json" ]; then
      cat "$SCENARIO_DIR/koto-transition.json"
      exit 0
    fi
    echo '{"status":"transitioned"}'
    exit 0
    ;;
  "status"|"status "*)
    if [ -f "$SCENARIO_DIR/koto-status.json" ]; then
      cat "$SCENARIO_DIR/koto-status.json"
      exit 0
    fi
    ;;
  "query"|"query "*)
    if [ -f "$SCENARIO_DIR/koto-query.json" ]; then
      cat "$SCENARIO_DIR/koto-query.json"
      exit 0
    fi
    ;;
  *"context get"*)
    if [ -f "$SCENARIO_DIR/koto-context-batch-final-view.json" ]; then
      cat "$SCENARIO_DIR/koto-context-batch-final-view.json"
      exit 0
    fi
    # Default: empty batch view
    echo '{"children":[]}'
    exit 0
    ;;
  # `context add` / `remove` / `exists` are stateful rather than canned, because
  # the retry clearing block reads `remove`'s exit status and then `exists`'s.
  # A canned reply cannot express "the key is gone now", and a fall-through to
  # the no-match exit 1 below would abort the block at its first key -- so an
  # agent that did exactly the right thing would look like it had failed.
  #
  # State is a marker file per key, under a scenario-scoped directory. Presence
  # starts empty: an eval that needs a key present writes it with `context add`
  # first, the same way a real run does.
  *"context add"*)
    cat >/dev/null 2>&1 || true   # drain the heredoc the caller pipes in
    set -- $ARGS                  # context add <WF> <KEY> [--from-file ...]
    mkdir -p "$CTX_STATE"
    [ -n "${4:-}" ] && : > "$CTX_STATE/$(printf '%s' "$4" | tr '/' '_')"
    exit 0
    ;;
  *"context remove"*)
    set -- $ARGS                  # context remove <WF> <KEY>
    mkdir -p "$CTX_STATE"
    # Idempotent, matching koto: removing a key that was never written exits 0.
    [ -n "${4:-}" ] && rm -f "$CTX_STATE/$(printf '%s' "$4" | tr '/' '_')"
    exit 0
    ;;
  *"context exists"*)
    set -- $ARGS                  # context exists <WF> <KEY>
    if [ -n "${4:-}" ] && [ -f "$CTX_STATE/$(printf '%s' "$4" | tr '/' '_')" ]; then
      exit 0                      # present
    fi
    exit 1                        # absent
    ;;
  # No `context list` arm on purpose. The clearing block uses `remove` and
  # `exists` only, and an earlier version of this shim added `list` for
  # completeness -- which changed what an unrelated eval sees when it probes:
  # exit 1 "no match" became exit 0 with empty output. Two evals that probe
  # `list` regressed in the run that introduced it. The failing assertions were
  # about `koto next` replay rather than about `list`, so it was probably not
  # the cause, but adding a verb nothing needs is not worth an environment
  # delta that cannot be fully accounted for. `list` falls through below.
esac

echo "koto shim: no match for args: $ARGS" >&2
exit 1
