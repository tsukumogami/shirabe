#!/usr/bin/env bash
set -euo pipefail

# koto shim for eval scenarios
# Reads EVAL_SCENARIO env var and returns canned data from fixtures/scenarios/<scenario>/.
# Stateless unless the eval declares KOTO_CALL_LOG; see the session-state block
# below for what it keeps then.

FIXTURES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCENARIO_DIR="$FIXTURES_DIR/scenarios/${EVAL_SCENARIO:-}"

if [ -z "${EVAL_SCENARIO:-}" ]; then
  echo "Error: EVAL_SCENARIO not set" >&2
  exit 1
fi

# Scenario: koto not installed — simulate command not found
if [ "$EVAL_SCENARIO" = "koto-missing" ]; then
  echo "bash: koto: command not found" >&2
  exit 127
fi

# A scenario that runs a real koto. The merge-step scenarios need the engine
# itself: its gates, its default actions, its result maps, and its refusals are
# what they assert on, and a canned answer would assert nothing. A scenario that
# carries a `koto-passthrough` file hands every call to the next `koto` on PATH
# after this shim's own directory.
if [ -f "$SCENARIO_DIR/koto-passthrough" ]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  OLD_IFS=$IFS
  IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    real_dir=$(cd "$d" 2>/dev/null && pwd) || continue
    [ "$real_dir" = "$SELF_DIR" ] && continue
    if [ -x "$real_dir/koto" ]; then
      IFS=$OLD_IFS
      exec "$real_dir/koto" "$@"
    fi
  done
  IFS=$OLD_IFS
  echo "koto shim: the scenario asks for a real koto, and none is on PATH" >&2
  exit 127
fi

# Normalize args for pattern matching
ARGS="$*"

# Session state, for a scenario whose run has to read back what it did: the
# context keys the skill added, the context a transition assigned, and the
# state a tick landed on. It needs KOTO_CALL_LOG (the eval's `env` declares
# it); the state lives in "$KOTO_CALL_LOG.d" and every call is appended to the
# log. Without it the shim is stateless, as it always was.
#
# The state is keyed by scenario as well as by session, because scenarios
# share a clone and a session name (execute-diamond-test). And `init` with
# --replace-terminal on a finished session starts it fresh, as koto does: that
# is how /execute enters, so a later run in the same clone doesn't inherit an
# earlier run's terminal.
STATE_DIR=""
if [ -n "${KOTO_CALL_LOG:-}" ]; then
  STATE_DIR="$KOTO_CALL_LOG.d/$EVAL_SCENARIO"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$ARGS" >> "$KOTO_CALL_LOG"
fi

# key_file <session> <key> -- where a stored context key lives.
key_file() {
  printf '%s/ctx/%s/%s' "$STATE_DIR" "$1" "$(printf '%s' "$2" | tr '/' '_')"
}

if [ -n "$STATE_DIR" ] && [ "${1:-}" = init ] && [ -n "${2:-}" ] \
    && case " $ARGS " in *" --replace-terminal "*) true ;; *) false ;; esac \
    && [ -f "$STATE_DIR/status/$2.json" ] \
    && jq -e '.is_terminal == true' "$STATE_DIR/status/$2.json" >/dev/null 2>&1; then
  rm -rf "$STATE_DIR/ctx/$2" "$STATE_DIR/last/$2.json" "$STATE_DIR/status/$2.json"
fi

# An execute session's tick: `next execute-<slug> [--with-data <json|@file>]`.
# A bare tick answers koto-next-execute.json. A tick with evidence answers
# koto-next-execute-<field>-<value>.json for the first string field that has
# one, so the answer follows what the agent submitted. With session state, the
# tick also records the state it landed on for `status`, and applies the
# fixture's <name>.context.json: a map of context keys to values in which
# ${evidence.<field>} stands for the submitted field, as a transition's
# context_assignments would. A tick with no fixture fails as no match.
if [ "${1:-}" = next ] && case "${2:-}" in execute-*) true ;; *) false ;; esac; then
  wf=$2
  data=""
  prev=""
  for a in "$@"; do
    [ "$prev" = "--with-data" ] && data=$a
    prev=$a
  done
  case "$data" in @*) data=$(cat "${data#@}") ;; esac
  if [ -n "$data" ]; then
    command -v jq >/dev/null 2>&1 || { echo "koto shim: evidence needs jq" >&2; exit 1; }
  fi

  # A finished session refuses evidence and keeps its context, as koto does.
  if [ -n "$data" ] && [ -n "$STATE_DIR" ] && [ -f "$STATE_DIR/last/$wf.json" ] \
      && jq -e '.action == "done"' "$STATE_DIR/last/$wf.json" >/dev/null 2>&1; then
    printf '{"error":{"code":"terminal_state","details":[],"message":"cannot submit evidence: state '"'"'%s'"'"' is terminal"}}\n' \
      "$(jq -r .state "$STATE_DIR/last/$wf.json")"
    exit 2
  fi

  # Evidence is checked against the fields the session's current state
  # expects -- where the last tick left it, or the first tick's answer -- and
  # refused as koto refuses it: an unknown field, a required field missing,
  # or an enum value outside its values. So an answer the state doesn't take
  # can't reach a fixture keyed on it.
  current=""
  if [ -n "$STATE_DIR" ] && [ -f "$STATE_DIR/last/$wf.json" ]; then
    current="$STATE_DIR/last/$wf.json"
  elif [ -f "$SCENARIO_DIR/koto-next-execute.json" ]; then
    current="$SCENARIO_DIR/koto-next-execute.json"
  fi
  if [ -n "$data" ] && [ -n "$current" ]; then
    # Every problem is reported, in koto's order: unknown fields first, then
    # each expected field in turn (missing, wrong type, value not allowed).
    details=$(printf '%s' "$data" | jq -c --slurpfile cur "$current" '
      . as $ev
      | ($cur[0].expects.fields // {}) as $f
      | [ $ev | keys_unsorted[] | select(. as $k | $f | has($k) | not)
            | {field: ., reason: ("unknown field \"" + . + "\"")} ]
        + [ $f | to_entries[] | .key as $k | .value as $spec
            | if ($ev | has($k) | not) then
                (if $spec.required == true then {field: $k, reason: "required field missing"} else empty end)
              elif $spec.type == "enum" then
                ($ev[$k] | type) as $t
                | if $t != "string" then {field: $k, reason: ("expected string for enum, got " + $t)}
                  elif ($spec.values | index($ev[$k])) then empty
                  else {field: $k, reason: ("value \"" + $ev[$k] + "\" is not in allowed values ["
                      + ($spec.values | map("\"" + . + "\"") | join(", ")) + "]")}
                  end
              elif ($spec.type == "string" or $spec.type == "number" or $spec.type == "boolean") then
                ($ev[$k] | type) as $t
                | if $t == $spec.type then empty else {field: $k, reason: ("expected " + $spec.type + ", got " + $t)} end
              else empty end ]') \
      || { echo "koto shim: could not validate the evidence against $current" >&2; exit 1; }
    if [ "$details" != "[]" ]; then
      printf '{"error":{"code":"invalid_submission","details":%s,"message":"evidence validation failed"}}\n' "$details"
      exit 2
    fi
  fi

  fixture=""
  if [ -z "$data" ]; then
    if [ -n "$STATE_DIR" ] && [ -f "$STATE_DIR/last/$wf.json" ]; then
      # A bare tick doesn't move the session: it answers where the last tick
      # left it, a terminal included.
      fixture="$STATE_DIR/last/$wf.json"
    elif [ -f "$SCENARIO_DIR/koto-next-execute.json" ]; then
      fixture="$SCENARIO_DIR/koto-next-execute.json"
    fi
  else
    fields=$(printf '%s' "$data" | jq -r 'to_entries[] | select(.value | type == "string") | "\(.key)=\(.value)"' 2>/dev/null) \
      || { echo "koto shim: --with-data is not a JSON object: $data" >&2; exit 2; }
    while IFS= read -r kv; do
      case "$kv" in
        *[!A-Za-z0-9._=-]*|"") continue ;;
      esac
      f="$SCENARIO_DIR/koto-next-execute-${kv%%=*}-${kv#*=}.json"
      if [ -f "$f" ]; then fixture=$f; break; fi
    done <<EOF_FIELDS
$fields
EOF_FIELDS
  fi

  if [ -n "$fixture" ]; then
    if [ -n "$STATE_DIR" ] && [ "$fixture" != "$STATE_DIR/last/$wf.json" ]; then
      mkdir -p "$STATE_DIR/last" "$STATE_DIR/status"
      cp "$fixture" "$STATE_DIR/last/$wf.json"
      jq -c --arg wf "$wf" '{current_state: .state, is_terminal: (.action == "done"), name: $wf}
        + (if .result then {result: .result} else {} end)' "$fixture" > "$STATE_DIR/status/$wf.json"
      assignments="${fixture%.json}.context.json"
      if [ -f "$assignments" ]; then
        evidence=$data
        [ -n "$evidence" ] || evidence='{}'
        for key in $(jq -r 'keys[]' "$assignments"); do
          mkdir -p "$STATE_DIR/ctx/$wf"
          jq -j --arg k "$key" --argjson ev "$evidence" \
            '.[$k] | gsub("\\$\\{evidence\\.(?<f>[A-Za-z0-9_]+)\\}"; ($ev[.f] // "" | tostring))' \
            "$assignments" > "$(key_file "$wf" "$key")"
        done
      fi
    fi
    cat "$fixture"
    exit 0
  fi
  # No fixture answers this tick. Stop here: the arms below match substrings
  # of the whole argument string, inline evidence included, and a word like
  # "transition" in it would pick up a canned success.
  echo "koto shim: no match for args: $ARGS" >&2
  exit 1
fi

case "$ARGS" in
  "version"|*"--version"*)
    echo '{"version":"0.2.1"}'
    exit 0
    ;;
  "workflows"|"workflows "*)
    if [ -f "$SCENARIO_DIR/koto-workflows.json" ]; then
      cat "$SCENARIO_DIR/koto-workflows.json"
      exit 0
    fi
    # Default: no active workflows
    echo '[]'
    exit 0
    ;;
  *"next work-on"*|*"next"*"work-on"*)
    if [ -f "$SCENARIO_DIR/koto-next-work-on.json" ]; then
      cat "$SCENARIO_DIR/koto-next-work-on.json"
      exit 0
    fi
    ;;
  "init"*|*"init "*)
    if [ -f "$SCENARIO_DIR/koto-init.json" ]; then
      cat "$SCENARIO_DIR/koto-init.json"
      exit 0
    fi
    # Default: successful init. `outcome` is the field scripts/koto-open.sh
    # reads (/execute enters through it), and `created` is its new-session
    # answer; the older fields stay for anything that read them.
    echo '{"status":"initialized","workflow":"work-on","outcome":"created"}'
    exit 0
    ;;
  *"transition"*)
    if [ -f "$SCENARIO_DIR/koto-transition.json" ]; then
      cat "$SCENARIO_DIR/koto-transition.json"
      exit 0
    fi
    echo '{"status":"transitioned"}'
    exit 0
    ;;
  "status"|"status "*)
    if [ -n "$STATE_DIR" ] && [ -f "$STATE_DIR/status/${2:-}.json" ]; then
      cat "$STATE_DIR/status/$2.json"
      exit 0
    fi
    if [ -f "$SCENARIO_DIR/koto-status.json" ]; then
      cat "$SCENARIO_DIR/koto-status.json"
      exit 0
    fi
    # The Resume guard (#360) reads is_terminal here before Step 2's koto init,
    # so every re-entry scenario now reaches this arm. Falling through to the
    # no-match error would fail a path that worked before the guard existed.
    # The default is a live session, which is what a resuming scenario means; a
    # scenario wanting the retained-terminal case pins koto-status.json.
    echo '{"current_state":"unknown","is_terminal":false}'
    exit 0
    ;;
  *"session cleanup"*)
    # The Resume guard's recovery, once a retained record has been read.
    exit 0
    ;;
  "query"|"query "*)
    if [ -f "$SCENARIO_DIR/koto-query.json" ]; then
      cat "$SCENARIO_DIR/koto-query.json"
      exit 0
    fi
    ;;
  "context add "*)
    # Stored only with session state; without it this stays unmatched, as it
    # always was.
    if [ -n "$STATE_DIR" ] && [ -n "${4:-}" ]; then
      mkdir -p "$STATE_DIR/ctx/$3"
      if [ "${5:-}" = "--from-file" ] && [ -n "${6:-}" ]; then
        cat "$6" > "$(key_file "$3" "$4")"
      else
        cat > "$(key_file "$3" "$4")"
      fi
      exit 0
    fi
    ;;
  "context exists "*)
    if [ -n "$STATE_DIR" ] && [ -n "${4:-}" ]; then
      if [ -f "$(key_file "$3" "$4")" ] \
          || [ -f "$SCENARIO_DIR/koto-context-$(printf '%s' "$4" | tr '/' '_')" ]; then
        exit 0
      fi
      exit 1
    fi
    ;;
  *"context get"*)
    # A key-named fixture wins: koto-context-<key> answers `context get <WF>
    # <key>` for that key alone. The drift check reads two keys koto's own
    # drift_facts action wrote (drift_facts.json, plan_intent.md), and the
    # batch view below would be the wrong answer for either.
    set -- $ARGS                  # context get <WF> <KEY>
    # Order: a key this run stored or a transition assigned, then a key-named
    # fixture, then the batch view.
    if [ -n "$STATE_DIR" ] && [ -n "${4:-}" ] && [ -f "$(key_file "$3" "$4")" ]; then
      cat "$(key_file "$3" "$4")"
      exit 0
    fi
    if [ -n "${4:-}" ] && [ -f "$SCENARIO_DIR/koto-context-$(printf '%s' "$4" | tr '/' '_')" ]; then
      cat "$SCENARIO_DIR/koto-context-$(printf '%s' "$4" | tr '/' '_')"
      exit 0
    fi
    if [ -f "$SCENARIO_DIR/koto-context-batch-final-view.json" ]; then
      cat "$SCENARIO_DIR/koto-context-batch-final-view.json"
      exit 0
    fi
    # Default: empty batch view
    echo '{"children":[]}'
    exit 0
    ;;
esac

echo "koto shim: no match for args: $ARGS" >&2
exit 1
