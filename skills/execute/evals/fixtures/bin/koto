#!/usr/bin/env bash
set -euo pipefail

# koto shim for eval scenarios
# Reads EVAL_SCENARIO env var and returns canned data from fixtures/scenarios/<scenario>/

FIXTURES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCENARIO_DIR="$FIXTURES_DIR/scenarios/${EVAL_SCENARIO:-}"

if [ -z "${EVAL_SCENARIO:-}" ]; then
  echo "Error: EVAL_SCENARIO not set" >&2
  exit 1
fi

# Scenario: koto not installed — simulate command not found
if [ "$EVAL_SCENARIO" = "koto-missing" ]; then
  echo "bash: koto: command not found" >&2
  exit 127
fi

# A scenario that runs a real koto. The merge-step scenarios need the engine
# itself: its gates, its default actions, its result maps, and its refusals are
# what they assert on, and a canned answer would assert nothing. A scenario that
# carries a `koto-passthrough` file hands every call to the next `koto` on PATH
# after this shim's own directory.
if [ -f "$SCENARIO_DIR/koto-passthrough" ]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  OLD_IFS=$IFS
  IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    real_dir=$(cd "$d" 2>/dev/null && pwd) || continue
    [ "$real_dir" = "$SELF_DIR" ] && continue
    if [ -x "$real_dir/koto" ]; then
      IFS=$OLD_IFS
      exec "$real_dir/koto" "$@"
    fi
  done
  IFS=$OLD_IFS
  echo "koto shim: the scenario asks for a real koto, and none is on PATH" >&2
  exit 127
fi

# Normalize args for pattern matching
ARGS="$*"

case "$ARGS" in
  "version"|*"--version"*)
    echo '{"version":"0.2.1"}'
    exit 0
    ;;
  "workflows"|"workflows "*)
    if [ -f "$SCENARIO_DIR/koto-workflows.json" ]; then
      cat "$SCENARIO_DIR/koto-workflows.json"
      exit 0
    fi
    # Default: no active workflows
    echo '[]'
    exit 0
    ;;
  *"next work-on"*|*"next"*"work-on"*)
    if [ -f "$SCENARIO_DIR/koto-next-work-on.json" ]; then
      cat "$SCENARIO_DIR/koto-next-work-on.json"
      exit 0
    fi
    ;;
  "init"*|*"init "*)
    if [ -f "$SCENARIO_DIR/koto-init.json" ]; then
      cat "$SCENARIO_DIR/koto-init.json"
      exit 0
    fi
    # Default: successful init. `outcome` is the field scripts/koto-open.sh
    # reads (/execute enters through it), and `created` is its new-session
    # answer; the older fields stay for anything that read them.
    echo '{"status":"initialized","workflow":"work-on","outcome":"created"}'
    exit 0
    ;;
  *"transition"*)
    if [ -f "$SCENARIO_DIR/koto-transition.json" ]; then
      cat "$SCENARIO_DIR/koto-transition.json"
      exit 0
    fi
    echo '{"status":"transitioned"}'
    exit 0
    ;;
  "status"|"status "*)
    if [ -f "$SCENARIO_DIR/koto-status.json" ]; then
      cat "$SCENARIO_DIR/koto-status.json"
      exit 0
    fi
    # The Resume guard (#360) reads is_terminal here before Step 2's koto init,
    # so every re-entry scenario now reaches this arm. Falling through to the
    # no-match error would fail a path that worked before the guard existed.
    # The default is a live session, which is what a resuming scenario means; a
    # scenario wanting the retained-terminal case pins koto-status.json.
    echo '{"current_state":"unknown","is_terminal":false}'
    exit 0
    ;;
  *"session cleanup"*)
    # The Resume guard's recovery, once a retained record has been read.
    exit 0
    ;;
  "query"|"query "*)
    if [ -f "$SCENARIO_DIR/koto-query.json" ]; then
      cat "$SCENARIO_DIR/koto-query.json"
      exit 0
    fi
    ;;
  *"context get"*)
    # A key-named fixture wins: koto-context-<key> answers `context get <WF>
    # <key>` for that key alone. The drift check reads two keys koto's own
    # drift_facts action wrote (drift_facts.json, plan_intent.md), and the
    # batch view below would be the wrong answer for either.
    set -- $ARGS                  # context get <WF> <KEY>
    if [ -n "${4:-}" ] && [ -f "$SCENARIO_DIR/koto-context-$(printf '%s' "$4" | tr '/' '_')" ]; then
      cat "$SCENARIO_DIR/koto-context-$(printf '%s' "$4" | tr '/' '_')"
      exit 0
    fi
    if [ -f "$SCENARIO_DIR/koto-context-batch-final-view.json" ]; then
      cat "$SCENARIO_DIR/koto-context-batch-final-view.json"
      exit 0
    fi
    # Default: empty batch view
    echo '{"children":[]}'
    exit 0
    ;;
esac

echo "koto shim: no match for args: $ARGS" >&2
exit 1
