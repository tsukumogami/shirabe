#!/usr/bin/env bash
# A koto stand-in for /coordinate's script tests. Not shipped behaviour: a test
# puts this directory first on PATH.
#
# A session S lives at $KOTO_STORE/sessions/S/; a test writes its prepared
# state log there as koto-S.state.jsonl, in the shape real koto writes (a
# header line, then events with seq, timestamp, type and payload). Context
# keys are files under $KOTO_STORE/context/S/, and a request R's view (what
# `request get R` prints) is $KOTO_STORE/requests/R.json. Every call is appended to
# $KOTO_STORE/calls.
#
# Served: `session dir S`, `session list` (a JSON array of {id,
# parent_workflow} for every session directory; parent_workflow is null unless
# the directory holds a .parent file), `status S` ({name, is_terminal}; the
# session is terminal when its directory holds a .terminal file; exit 1 for a
# session that doesn't exist), `context add S K [--from-file F]` (stdin
# without --from-file), `context get S K`, and `template compile P`, which
# prints $KOTO_STORE/cache/<$KOTO_COMPILED_HASH>.json so coord-log.sh
# provenance can be passed or failed by the header's template_hash, or fails
# when KOTO_COMPILE_FAIL is set. Anything
# else exits 9.
set -uo pipefail
[ -n "${KOTO_STORE:-}" ] || { echo "koto stub: KOTO_STORE is not set" >&2; exit 9; }
printf '%s\n' "$*" >> "$KOTO_STORE/calls"
case "${1:-} ${2:-}" in
    "session dir")
        printf '%s\n' "$KOTO_STORE/sessions/${3:-none}"
        ;;
    "session list")
        for d in "$KOTO_STORE"/sessions/*/; do
            [ -d "$d" ] || continue
            id=$(basename "$d")
            parent=null
            [ -f "$d/.parent" ] && parent=$(jq -Rs 'rtrimstr("\n")' < "$d/.parent")
            jq -nc --arg id "$id" --argjson p "$parent" '{id: $id, parent_workflow: $p}'
        done | jq -s -c '.'
        ;;
    "status "*)
        d="$KOTO_STORE/sessions/${2:-none}"
        [ -n "${2:-}" ] && [ -d "$d" ] || { echo "koto stub: no session ${2:-}" >&2; exit 1; }
        t=false
        [ -f "$d/.terminal" ] && t=true
        jq -nc --arg n "$2" --argjson t "$t" '{name: $n, is_terminal: $t}'
        ;;
    "context add")
        [ -z "${KOTO_FAIL_ADD:-}" ] || exit 1
        d="$KOTO_STORE/context/${3:-none}"
        mkdir -p "$(dirname "$d/$4")"
        if [ "${5:-}" = --from-file ]; then cat "$6" > "$d/$4" || exit 1; else cat > "$d/$4"; fi
        ;;
    "context get")
        cat "$KOTO_STORE/context/${3:-none}/$4" 2>/dev/null || exit 1
        ;;
    "request get")
        cat "$KOTO_STORE/requests/${3:-none}.json" 2>/dev/null || { echo "koto stub: no request ${3:-}" >&2; exit 1; }
        ;;
    "template compile")
        [ -z "${KOTO_COMPILE_FAIL:-}" ] || { echo "koto stub: compile failed" >&2; exit 1; }
        printf '%s\n' "$KOTO_STORE/cache/${KOTO_COMPILED_HASH:-0000}.json"
        ;;
    *) echo "koto stub: unexpected: $*" >&2; exit 9 ;;
esac
