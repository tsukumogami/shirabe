#!/usr/bin/env bash
# A koto stand-in for /coordinate's script tests. Not shipped behaviour: a test
# puts this directory first on PATH.
#
# A session S lives at $KOTO_STORE/sessions/S/; a test writes its prepared
# state log there as koto-S.state.jsonl, in the shape real koto writes (a
# header line, then events with seq, timestamp, type and payload). Context
# keys are files under $KOTO_STORE/context/S/, and a request R's view (what
# `request get R` prints) is $KOTO_STORE/requests/R.json; a file R.gone there
# makes it a request this host's store doesn't hold (koto's exit 2). Every
# call is appended to $KOTO_STORE/calls.
#
# Served: `session dir S`, `session list` (a JSON array of {id,
# parent_workflow} for every session directory; parent_workflow is null unless
# the directory holds a .parent file), `status S` ({name, is_terminal}; the
# session is terminal when its directory holds a .terminal file; exit 1 for a
# session that doesn't exist), `context add S K [--from-file F]` (stdin
# without --from-file), `context get S K`, `context exists S K` (exit 1 when
# absent), `context remove S K`, `context list [--prefix P] S` (a JSON array of
# keys; with KOTO_NO_LIST_PREFIX set, --prefix is refused as an older koto would,
# and KOTO_LIST_HIDE=<k> leaves out the k highest keys of a record/entries/ listing, a list another writer
# has since added to), `context list --help` and `session import --help` (the
# session store's feature probe: both features only with KOTO_FEATURES=1),
# and `template compile P`, which
# prints $KOTO_STORE/cache/<$KOTO_COMPILED_HASH>.json so coord-log.sh
# provenance can be passed or failed by the header's template_hash, or fails
# when KOTO_COMPILE_FAIL is set. Anything
# else exits 9. With KOTO_CALL_DELAY=<seconds> set, every context call takes
# that long first, as a real koto call does (about 0.1 s each, measured), so a
# suite can show what a read costs in calls rather than on a stand-in that
# answers at once. KOTO_BOUND_ELSEWHERE=<session> refuses every `context` read
# and `status` of that session as koto's cloud backend refuses a run bound to
# another directory (session_bound_elsewhere, its JSON on stdout, exit 2), and
# KOTO_READ_FAIL=<session> fails them with another error (exit 1).
set -uo pipefail
[ -n "${KOTO_STORE:-}" ] || { echo "koto stub: KOTO_STORE is not set" >&2; exit 9; }
printf '%s\n' "$*" >> "$KOTO_STORE/calls"
[ "${1:-}" = context ] && [ -n "${KOTO_CALL_DELAY:-}" ] && sleep "$KOTO_CALL_DELAY"
case "${1:-} ${2:-}" in
    "context get"|"context list"|"context exists"|status\ *)
        for a in "$@"; do
            if [ -n "${KOTO_BOUND_ELSEWHERE:-}" ] && [ "$a" = "$KOTO_BOUND_ELSEWHERE" ]; then
                jq -nc --arg s "$a" '{error: "session_bound_elsewhere: session \($s) is bound to another directory", code: "session_bound_elsewhere", session: $s}'
                exit 2
            fi
            if [ -n "${KOTO_READ_FAIL:-}" ] && [ "$a" = "$KOTO_READ_FAIL" ]; then
                echo "koto stub: the read of $a failed" >&2; exit 1
            fi
        done ;;
esac
case "${1:-} ${2:-}" in
    "session dir")
        printf '%s\n' "$KOTO_STORE/sessions/${3:-none}"
        ;;
    "session list")
        for d in "$KOTO_STORE"/sessions/*/; do
            [ -d "$d" ] || continue
            id=$(basename "$d")
            parent=null
            [ -f "$d/.parent" ] && parent=$(jq -Rs 'rtrimstr("\n")' < "$d/.parent")
            jq -nc --arg id "$id" --argjson p "$parent" '{id: $id, parent_workflow: $p}'
        done | jq -s -c '.'
        ;;
    "status "*)
        d="$KOTO_STORE/sessions/${2:-none}"
        [ -n "${2:-}" ] && [ -d "$d" ] || { echo "koto stub: no session ${2:-}" >&2; exit 1; }
        t=false
        [ -f "$d/.terminal" ] && t=true
        jq -nc --arg n "$2" --argjson t "$t" '{name: $n, is_terminal: $t}'
        ;;
    "context add")
        # KOTO_FAIL_ADD=1 fails every add; set to a key's name, only that key's.
        case "${KOTO_FAIL_ADD:-}" in "") ;; 1|"${4:-}") exit 1 ;; esac
        d="$KOTO_STORE/context/${3:-none}"
        mkdir -p "$(dirname "$d/$4")"
        if [ "${5:-}" = --from-file ]; then cat "$6" > "$d/$4" || exit 1; else cat > "$d/$4"; fi
        ;;
    "context get")
        cat "$KOTO_STORE/context/${3:-none}/$4" 2>/dev/null || exit 1
        ;;
    "context exists")
        [ -f "$KOTO_STORE/context/${3:-none}/$4" ] || exit 1
        ;;
    "context remove")
        rm -f "$KOTO_STORE/context/${3:-none}/$4"
        ;;
    "session import")
        # Probed with --help; KOTO_FEATURES=1 makes this a koto that has it.
        [ -n "${KOTO_FEATURES:-}" ] && [ "${3:-}" = --help ] && { echo "Usage: koto session import [OPTIONS] --from <WORKSPACE_PATH> <NAME>"; exit 0; }
        echo "koto stub: unexpected: $*" >&2; exit 9
        ;;
    "context list")
        if [ "${3:-}" = --help ]; then
            if [ -n "${KOTO_FEATURES:-}" ]; then
                printf 'Usage: koto context list [OPTIONS] <SESSION>\n\nOptions:\n      --prefix <PREFIX>  Filter keys by prefix\n'
            else
                printf 'Usage: koto context list <SESSION>\n'
            fi
            exit 0
        fi
        # `context list [--prefix P] S`, the option before or after the session,
        # printed as real koto prints it: a JSON array of keys, sorted.
        [ -z "${KOTO_NO_LIST_PREFIX:-}" ] || { [ "${3:-}" != --prefix ] && [ "${4:-}" != --prefix ]; } \
            || { echo "koto stub: unexpected argument '--prefix'" >&2; exit 2; }
        s= p=
        shift 2
        while [ $# -gt 0 ]; do
            case "$1" in --prefix) p=$2; shift 2 ;; *) s=$1; shift ;; esac
        done
        d="$KOTO_STORE/context/$s"
        if [ -d "$d" ]; then
            # KOTO_LIST_HIDE=<k> leaves the k highest keys out of the
            # record/entries/ listing, as a list read just before another writer
            # added them would; every other listing, a single key's included, is
            # whole.
            h=${KOTO_LIST_HIDE:-0}
            [ "$p" = record/entries/ ] || h=0
            (cd "$d" && find . -type f | sed 's|^\./||') | LC_ALL=C sort \
                | jq -R -s -c --arg p "$p" --argjson h "$h" \
                    'split("\n") | map(select(. != "" and startswith($p))) | .[0:(length - $h | if . < 0 then 0 else . end)]'
        else
            echo '[]'
        fi
        ;;
    "request get")
        # A request this host's store doesn't hold is answered with koto's 2.
        [ -e "$KOTO_STORE/requests/${3:-none}.gone" ] && { echo "koto stub: request_not_found ${3:-}" >&2; exit 2; }
        cat "$KOTO_STORE/requests/${3:-none}.json" 2>/dev/null || { echo "koto stub: no request ${3:-}" >&2; exit 1; }
        ;;
    "template compile")
        [ -z "${KOTO_COMPILE_FAIL:-}" ] || { echo "koto stub: compile failed" >&2; exit 1; }
        printf '%s\n' "$KOTO_STORE/cache/${KOTO_COMPILED_HASH:-0000}.json"
        ;;
    *) echo "koto stub: unexpected: $*" >&2; exit 9 ;;
esac
