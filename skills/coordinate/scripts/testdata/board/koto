#!/usr/bin/env bash
# koto stand-in for the board, land and merge tests (KOTO_BIN points here).
# Serves hand-written session logs from $KOTO_BOARD_DIR/sessions/<S>/, keeps
# context keys as files beside them (add, get, exists, and list with
# --prefix; a get of a record/ key past the count in $KOTO_BOARD_DIR/get-fail-after
# fails), serves `request get` from $KOTO_BOARD_DIR/requests/, and answers
# `template compile` with a
# path whose name is $KOTO_BOARD_HASH, which is what coord-log.sh provenance
# compares with the header's template_hash. Anything else exits 9.
set -uo pipefail
D=${KOTO_BOARD_DIR:?}
printf '%s\n' "$*" >> "$D/koto.calls"
case "${1-} ${2-}" in
    "session dir") [ -d "$D/sessions/${3-}" ] || exit 1; printf '%s\n' "$D/sessions/$3" ;;
    "context add")
        [ -f "$D/fail-context" ] && exit 1
        [ "${5-}" = --from-file ] || exit 9
        mkdir -p "$D/sessions/$3/ctx"
        cp "$6" "$D/sessions/$3/ctx/$(printf '%s' "$4" | sed 's#/#__#g')" ;;
    "context get")
        # $D/get-fail-after holding N: the record/ reads after the Nth fail, so
        # a test can let one read of the record through and fail the next.
        case "$4" in record/*)
            if [ -f "$D/get-fail-after" ]; then
                n=$(( $(cat "$D/get-count" 2>/dev/null || echo 0) + 1 ))
                echo "$n" > "$D/get-count"
                [ "$n" -gt "$(cat "$D/get-fail-after")" ] && exit 1
            fi ;;
        esac
        cat "$D/sessions/$3/ctx/$(printf '%s' "$4" | sed 's#/#__#g')" 2>/dev/null || exit 1 ;;
    "context exists") [ -f "$D/sessions/$3/ctx/$(printf '%s' "$4" | sed 's#/#__#g')" ] || exit 1 ;;
    "context list")
        # `context list S --prefix P`: the keys under P as a sorted JSON array.
        s=$3 p=
        [ "${4-}" = --prefix ] && p=${5-}
        [ -d "$D/sessions/$s/ctx" ] || { echo '[]'; exit 0; }
        (cd "$D/sessions/$s/ctx" && ls) | sed 's#__#/#g' | LC_ALL=C sort \
            | jq -R -s -c --arg p "$p" 'split("\n") | map(select(. != "" and startswith($p)))' ;;
    "request get")
        # A request's view from $D/requests/<R>.json; <R>.gone is one this
        # host's store doesn't hold (koto's 2), <R>.fail a read that fails.
        [ -e "$D/requests/${3-}.gone" ] && { echo "koto stand-in: request_not_found" >&2; exit 2; }
        [ -e "$D/requests/${3-}.fail" ] && { echo "koto stand-in: store unreadable" >&2; exit 1; }
        cat "$D/requests/${3-}.json" 2>/dev/null || exit 1 ;;
    "template compile") printf '%s\n' "$D/cache/${KOTO_BOARD_HASH:-none}.json" ;;
    *) echo "koto stand-in: unexpected: $*" >&2; exit 9 ;;
esac
