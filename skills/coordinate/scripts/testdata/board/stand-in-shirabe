#!/usr/bin/env bash
# Stand-in shirabe for the land tests, linked as `shirabe` on PATH. Answers
# only `validate --pr-body <file> --pr-title <t> --format json`: prints
# $BT_STATE/shirabe.out when present (exit $BT_STATE/shirabe.rc, default 2),
# else a clean outcome. Logs its arguments to $BT_STATE/shirabe.calls.
# BT_STATE is optional: a suite that doesn't set it (the full-template engine
# test) gets the clean outcome and no log.
[ -n "${BT_STATE-}" ] && printf '%s\n' "$*" >> "$BT_STATE/shirabe.calls"
[ "${1-} ${2-}" = "validate --pr-body" ] || { echo "stand-in shirabe: unexpected call: $*" >&2; exit 9; }
if [ -n "${BT_STATE-}" ] && [ -f "$BT_STATE/shirabe.out" ]; then
    cat "$BT_STATE/shirabe.out"
    exit "$(cat "$BT_STATE/shirabe.rc" 2>/dev/null || echo 2)"
fi
echo '{"schema":"shirabe-pr-body/v1","outcome":"clean","findings":[]}'
